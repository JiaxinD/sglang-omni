// Development build that runs Voxt's ASR on the local SGLang-Omni server.
// Applied on top of the Debug configuration with `xcodebuild -xcconfig`.
// The .dev suffix keeps Sparkle disabled; the bundle identifier keeps its
// preferences apart from the release and the regular Dev build.
PRODUCT_BUNDLE_IDENTIFIER = com.voxt.Voxt.omni.dev
PRODUCT_NAME = Voxt Omni Dev
// The app launches the backend's Python supervisor, which a sandbox forbids.
ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS = Voxt/VoxtOmniDev.entitlements
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
